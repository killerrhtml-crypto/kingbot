<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KING BOT // CONFIGURACIÓN"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio Mínimo por KM (DOP):"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
        <EditText
            android:id="@+id/etMinPricePerKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="1.5"
            android:textColor="#00E5FF"
            android:backgroundTint="#00E5FF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio Total Mínimo (DOP):"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
        <EditText
            android:id="@+id/etMinTotalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="3.0"
            android:textColor="#00E5FF"
            android:backgroundTint="#00E5FF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio Máximo Permitido (DOP):"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
        <EditText
            android:id="@+id/etMaxPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="50.0"
            android:textColor="#00E5FF"
            android:backgroundTint="#00E5FF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distancia Máx. Recogida / Punto A (KM):"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
        <EditText
            android:id="@+id/etMaxPickupDist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="2.5"
            android:textColor="#00E5FF"
            android:backgroundTint="#00E5FF"/>

        <CheckBox
            android:id="@+id/cbDynamicPickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permitir Extensión Dinámica de Recogida"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distancia Máx. Total del Viaje / Punto B (KM):"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
        <EditText
            android:id="@+id/etMaxTotalDist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="20.0"
            android:textColor="#00E5FF"
            android:backgroundTint="#00E5FF"/>

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GUARDAR CONFIGURACIÓN"
            android:backgroundTint="#00E5FF"
            android:textColor="#000000"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnStartBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INICIAR BURBUJA FLOTANTE"
            android:backgroundTint="#00C853"
            android:textColor="#000000"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
